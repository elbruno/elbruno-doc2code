  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.1.0" />
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.1.0" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\elbruno.Doc2Code.ApiService\elbruno.Doc2Code.ApiService.csproj" />
    <ProjectReference Include="..\elbruno.Doc2Code.SettingsService\elbruno.Doc2Code.SettingsService.csproj" />
    <ProjectReference Include="..\elbruno.Doc2Code.Web\elbruno.Doc2Code.Web.csproj" />
  </ItemGroup>

</Project>
